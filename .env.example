# Copy to .env and fill in what you use. Keep it out of version control.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Signs saved results and baselines (recommended)
SECPOSTURE_SIGNING_KEY=

# SSH auditing
SECPOSTURE_SSH_KEY=~/.ssh/id_ed25519
SECPOSTURE_KNOWN_HOSTS=~/.ssh/known_hosts
SECPOSTURE_SSH_PORT=22

# Advisory feed (directory of OSV JSON; defaults to the bundled sample)
SECPOSTURE_ADVISORIES=
SECPOSTURE_OSV_API=false

# Dashboard: output of `secposture hash-password` (keep the single quotes)
SECPOSTURE_DASHBOARD_PASSWORD_HASH=''
SECPOSTURE_RESULTS_DIR=results
